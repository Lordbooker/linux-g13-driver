#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # Activate the udev rule for the G13 and uinput (containers may have no udev)
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules 2>/dev/null || true
        udevadm trigger --subsystem-match=usb --attr-match=idVendor=046d --attr-match=idProduct=c21c 2>/dev/null || true
        udevadm trigger --subsystem-match=misc --sysname-match=uinput 2>/dev/null || true
    fi
    echo "linux-g13-driver: enable the driver for your user with:  systemctl --user enable --now g13"
    echo "linux-g13-driver: the tray icon starts at the next login (or now: g13-gui --tray &)"
fi

exit 0
