# Grant the logged-in user access to the Logitech G13 and uinput.
#
# "uaccess" grants access via ACL only to the user of the active local session
# (systemd-logind), not to all users and services. The tag is evaluated by
# 73-seat-late.rules, so this file must be sorted BEFORE 73.
SUBSYSTEM=="usb", ATTR{idVendor}=="046d", ATTR{idProduct}=="c21c", TAG+="uaccess"
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", OPTIONS+="static_node=uinput", TAG+="uaccess"
