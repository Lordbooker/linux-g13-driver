[Unit]
Description=Logitech G13 User Space Driver
After=graphical-session.target

[Service]
Type=simple
# Path for package installations and "make install" (PREFIX=/usr).
ExecStart=/usr/bin/linux-g13-driver
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target