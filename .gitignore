# =========================================
# General exclusions
# =========================================

# Log and temporary files
*.log
*.tmp
*~
*.swp

# Files generated by the operating system
.DS_Store
Thumbs.db


# =========================================
# C++ driver (g13-driver)
# =========================================

# Compiled object files
*.o
*.d

# Build directories and packages
/build/
/dist/
g13-driver/src/build/
g13-driver/build/
g13-driver/packaging/arch/*/
g13-driver/packaging/arch/*.pkg.tar.*



# Executable name used by old versions of the driver
Linux-G13-Driver


# =========================================
# Folder for experimental stuff
# =========================================
experimental_stuff/


# =========================================
# IDE-specific configuration files
# =========================================

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Eclipse
.classpath
.project
.settings/

# VS Code
.vscode/

# Netbeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
.nb-gradle/

# CLion / CMake
/cmake-build-*/
# Python bytecode
__pycache__/
*.pyc
